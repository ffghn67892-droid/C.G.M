{
  "name": "deckroom",
  "version": "1.0.0",
  "description": "Multi-game card game management desktop app",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "test": "node --test tests/catalog-critical.test.cjs tests/catalog-safety.test.cjs tests/catalog-additional.test.cjs tests/catalog-engine-v2.test.cjs tests/catalog-editor-v2.test.cjs tests/catalog-view-v2.test.cjs tests/catalog-setup-v2.test.cjs",
    "start": "electron .",
    "dev:web": "npx serve .",
    "dist": "electron-builder --win nsis",
    "format": "prettier --write \"*.js\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\"",
    "format:check": "prettier --check \"*.js\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\""
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.8.15",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.8",
    "serve": "^14.2.4"
  },
  "build": {
    "appId": "com.deckroom.app",
    "productName": "DECKROOM",
    "files": [
      "index.html",
      "styles.css",
      "manager.css",
      "schedules.js",
      "game-data.js",
      "app.js",
      "reward-ledger.js",
      "pass-data.js",
      "game-config.js",
      "setup.js",
      "overview.js",
      "alerts.js",
      "catalog-engine.js",
      "catalog-presets.js",
      "catalog-view.js",
      "catalog-editor.js",
      "refresh-scheduler.js",
      "legacy-migrations.js",
      "manager.js",
      "electron-main.js",
      "preload.js",
      "desktop-main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "DECKROOM-Setup-${version}.${ext}"
    }
  }
}
